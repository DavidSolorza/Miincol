# URL base de la API REST del backend
VITE_API_BASE_URL=https://misincol-api.servidor.blog/api

# Target para proxy de desarrollo en Vite
VITE_API_PROXY_TARGET=https://misincol-api.servidor.blog

# Entorno de ejecución (development | production)
VITE_APP_ENV=production

