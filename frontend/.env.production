# ==============================================================================
# MISINCOL PDM - Variables de Entorno de Producción (Frontend)
# Configurado para conexión directa con servidor remoto y despliegue en Vercel
# ==============================================================================

# URL base de la API REST del backend en producción
VITE_API_BASE_URL=https://misincol-api.servidor.blog/api

# Target para proxy de desarrollo en Vite (opcional para desarrollo local)
VITE_API_PROXY_TARGET=https://misincol-api.servidor.blog

# Modo de la aplicación
VITE_APP_ENV=production

